# Application Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL 17)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/healthcare_db?schema=public"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-replace-this-in-production"
JWT_EXPIRES_IN="1d"

# CORS Configuration (optional, defaults to allow all)
CORS_ORIGIN="*"
